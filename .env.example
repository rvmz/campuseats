# Copy to .env for local processes. Compose and Kubernetes set these themselves.
# .env is gitignored.

HTTP_ADDR=:8080
GRPC_ADDR=:9090
HEALTH_ADDR=:8081
ORDER_ADDR=localhost:9090
DATABASE_URL=postgres://campuseats:campuseats@localhost:5432/campuseats?sslmode=disable
KAFKA_BROKERS=localhost:9092
JWT_SECRET=dev-only-change-me
PUBLISH_ENABLED=true

# Session 10. Leave empty to skip receipt upload.
AWS_REGION=eu-central-1
RECEIPTS_BUCKET=
